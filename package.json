{
  "name": "geo-growth-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GEO 获客推广系统 · 批次1：工程底座 + 免费工具 + 可分享结果页",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "node scripts/preflight.ts && next build",
    "start": "node scripts/preflight.ts && next start -p 3100",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/*.test.ts\"",
    "db:reset": "rm -rf data",
    "screenshot": "node scripts/screenshot.mjs",
    "verify": "pnpm typecheck && pnpm test && pnpm build",
    "preflight": "node scripts/preflight.ts",
    "seed": "node scripts/seed.ts",
    "e2e:eval": "node scripts/e2e-eval-click.mjs",
    "e2e:auth": "node scripts/e2e-auth.mjs"
  },
  "dependencies": {
    "@tabler/icons-react": "^3.47.0",
    "cheerio": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "lucide-react": "^1.47.0",
    "motion": "^13.4.0",
    "next": "^15.5.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "3.8.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "playwright-core": "^1.63.0",
    "postcss": "^8.5.28",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
