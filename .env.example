# 公开站基础地址：canonical / OpenGraph / sitemap 全部由它派生
# 换域名时只改这一处，不动代码
APP_BASE_URL=http://localhost:3100

# SQLite 数据文件路径（相对项目根目录）
DATABASE_PATH=./data/geo.db

# 默认工作区标识（多工作区 schema 已就位，批次1 只用这一个）
DEFAULT_WORKSPACE_SLUG=default

# 站点名称与联系邮箱（展示用）
SITE_NAME=GEO 可见度实验室
CONTACT_EMAIL=hello@example.com

# ---------------------------------------------------------------------------
# SSRF 逃生口（默认留空 = 最严格策略，生产环境请保持留空）
#
# 部分环境（企业网络 / 沙箱 / 评测平台）使用透明代理，把外网域名解析到固定
# 保留网段，例如 198.18.0.0/15（RFC 2544 基准测试段）。此时 SSRF 防护会把
# 正常的外网请求一并拒绝，表现为所有站点都报"该域名解析到内网地址"。
#
# 只有在确认自己处于这种环境时，才填入代理实际使用的网段（逗号分隔）。
# 配置后这些网段内的地址将可以被抓取 —— 请自行评估风险。
# ---------------------------------------------------------------------------
# EXTRA_TRUSTED_CIDRS=198.18.0.0/15

# 免费检查工具是纯规则实现。真实采样可选用 Perplexity 官方 Sonar API，
# 它可能产生平台费用，只有运营人员主动点击采集才会调用。
# PERPLEXITY_API_KEY=
# PERPLEXITY_MODEL=sonar

# 审核内容自动发布：本站知识页无需额外配置。外部渠道按需选择其一。
# WordPress 使用官方 REST Posts API 与 Application Password（HTTPS）。
# WORDPRESS_BASE_URL=https://your-wordpress.example
# WORDPRESS_USERNAME=
# WORDPRESS_APP_PASSWORD=
# 自有发布服务须接受幂等键并返回 {status:"published",url:"https://..."}。
# PUBLISH_WEBHOOK_URL=https://your-publisher.example/geo/publish
# PUBLISH_WEBHOOK_TOKEN=

# ---------------------------------------------------------------------------
# 启动前配置守卫（scripts/preflight.ts，在 build / start 之前运行）
#
# 若 APP_BASE_URL 指向本机地址（localhost / 127.0.0.1 / *.local 等），或
# CONTACT_EMAIL 仍是占位邮箱，脚本会**拒绝启动**并列出具体问题。
#
# 为什么是拒绝而不是警告：canonical / OpenGraph / sitemap 全部由 APP_BASE_URL 派生。
# 带着 localhost 上线，等于告诉搜索引擎与 AI 爬虫「本站的规范地址是本机」，
# 收录与引用会全面错乱；而假的联系邮箱会让线索直接丢失。
#
# 仅本地以生产模式自测（pnpm build && pnpm start）时才设置下面这一项。
# ⚠️ 正式部署环境不要设置。
# ---------------------------------------------------------------------------
# ALLOW_INSECURE_DEFAULTS=1

# ---------------------------------------------------------------------------
# 运营台鉴权（必需）
#
# /console 含线索联系方式与品牌数据，必须口令访问。
# **未配置时一律拒绝访问**（fail closed）—— 配置缺失不等于没有门。
#
#   CONSOLE_PASSWORD  操作员口令，至少 6 位。生产环境请用强口令。
#   AUTH_SECRET       会话 Cookie 的 HMAC 密钥，至少 16 位。
#                     生成方式：openssl rand -base64 32
#
# 会话为 HttpOnly + SameSite=Lax 的签名 Cookie，有效期 12 小时。
# 连续失败 8 次锁定 10 分钟（内存计数，多实例需换 Redis）。
# ---------------------------------------------------------------------------
CONSOLE_PASSWORD=change-me-before-deploy
AUTH_SECRET=generate-with-openssl-rand-base64-32

# ---------------------------------------------------------------------------
# 线索提醒通道（正式获客前应当配置）
#
# 不配置的后果：新线索会正常入库，但**不会提醒任何人** ——
# 你只在主动打开运营台时才会发现有人留了联系方式。
#
# 支持按 URL 自动识别格式，任选其一：
#   钉钉机器人    https://oapi.dingtalk.com/robot/send?access_token=xxx
#   企业微信机器人 https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx
#   飞书机器人    https://open.feishu.cn/open-apis/bot/v2/hook/xxx
#   Slack        https://hooks.slack.com/services/xxx
#   自定义端点    其它 URL 会收到结构化 JSON（type/leadId/email/...），便于对接 CRM
#
# 通知失败不会影响线索保存；失败原因会写回 leads.notify_error 并在运营台显示。
# ---------------------------------------------------------------------------
# LEAD_NOTIFY_WEBHOOK=

# ---------------------------------------------------------------------------
# 上线前必须删除的本地开关（配置守卫会检查）
#
#   ALLOW_INSECURE_DEFAULTS=1   → 跳过占位配置校验，仅本地自测用
#   EXTRA_TRUSTED_CIDRS=...     → 放宽 SSRF 防护，仅透明代理环境用
# ---------------------------------------------------------------------------
